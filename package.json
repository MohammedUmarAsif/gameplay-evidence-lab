{
  "name": "gameplay-evidence-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/backend.test.ts",
    "test:e2e": "playwright test",
    "test:backend": "tsx --test tests/backend.integration.ts",
    "verify:live": "node scripts/verify-live.mjs",
    "analyse:synthetic": "tsx scripts/analyse-export.ts --synthetic",
    "baseline:synthetic": "tsx scripts/run-baseline.ts --synthetic",
    "format": "prettier --write src backend build tests scripts *.ts *.json"
  },
  "dependencies": {
    "@primer/css": "^22.3.2",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
